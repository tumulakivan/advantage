{
  "name": "advantage",
  "private": true,
  "version": "0.2.0",
  "description": "adVantage - personal budget tracker (Express + PostgreSQL + Prisma)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run admin -w @advantage/api -- --if-configured",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate -w @advantage/api",
    "db:studio": "npm run db:studio -w @advantage/api",
    "db:reset": "npm run db:reset -w @advantage/api",
    "setup": "npm install && node scripts/setup-env.mjs && npm run db:up && npm run db:migrate && npm run db:seed:catalog",
    "smoke": "npm run smoke -w @advantage/api && npm run smoke -w @advantage/web",
    "setup:env": "node scripts/setup-env.mjs",
    "db:seed:catalog": "npm run db:seed:catalog -w @advantage/api",
    "admin": "npm run admin -w @advantage/api --"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
