# Copy to .env and adjust. The compose file publishes Postgres on 5433 so it
# cannot collide with a Postgres already installed on this machine.
DATABASE_URL="postgresql://advantage:advantage@localhost:5433/advantage?schema=public"

# Session signing key. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-random-bytes"

# Where the API itself is reachable. Better Auth builds callback URLs from it.
BETTER_AUTH_URL="http://localhost:4000"

# The browser origin allowed to send credentialed requests.
# Comma-separated. 4173 is where the e2e smoke test serves the built app.
WEB_ORIGIN="http://localhost:5173,http://localhost:4173"

PORT=4000
NODE_ENV=development

# Where the browser app looks for the API. Read at build time by Vite.
VITE_API_URL="http://localhost:4000"

# Comma-separated addresses that get the admin screens. Configuration rather
# than a column, so there is no way to become an admin through the product.
# Then: npm run admin -- --email <that address>
# The service prints the list on boot, so a typo shows as a wrong address.
#
# It can be made up: `npm run admin` creates it already confirmed, so nothing
# is ever sent to it. (Forgot password would go nowhere, but `npm run admin`
# sets a new one directly.)
#
# Use an address separate from the one you track your own money with. A
# plus-address needs no new mailbox: you+admin@gmail.com is a different account
# here while still reaching your inbox.
#
# The API smoke test's admin half needs admin@example.test on this list, and
# says so and skips if it is missing. Keep it out of production: it is a
# throwaway address for tests.
ADMIN_EMAILS=""

# Optional, and for local development only. When set, `npm run dev` makes sure
# the first ADMIN_EMAILS address exists with this password, creating the
# account if it is not there yet, so a `db:reset` does not cost you the admin.
# Leave it empty and nothing happens: create the account once with
# `npm run admin` and it stays in the database on its own.
#
# It is a readable password on disk and it is what every restart resets the
# account back to. Do not set it on a deployed service.
ADMIN_PASSWORD=""

# How mail leaves the service. Sign-in needs it now - an account cannot sign in
# until its address is confirmed - and so does Forgot password.
#
#   dev     Nothing is sent. Each message is printed in the API terminal and
#           appended to .mail/outbox.jsonl, which the smoke tests read.
#           The default everywhere except production.
#   resend  Sent through Resend's HTTPS API. Required in production: the service
#           refuses to start without it. The sender's domain must be verified in
#           Resend's dashboard, or it can only reach your own address.
MAIL_TRANSPORT="dev"
# MAIL_FROM="adVantage <no-reply@your-verified-domain>"
# RESEND_API_KEY=""
